# Local backend configuration. Copy this file to .env.
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000
DATA_PROVIDER=memory

# Demo-only authentication for local API testing.
# Replace these credentials and the signing secret before sharing/deploying.
DEMO_AUTH_ENABLED=true
DEMO_OWNER_USERNAME=owner
DEMO_OWNER_PASSWORD=change-this-owner-password
DEMO_CASHIER_USERNAME=cashier
DEMO_CASHIER_PASSWORD=change-this-cashier-password
AUTH_REQUIRED=true
TOKEN_SECRET=replace-this-with-a-long-random-secret-at-least-32-characters
TOKEN_TTL_SECONDS=28800

# Reserved for the database teammate's integration. No database client is configured yet.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
